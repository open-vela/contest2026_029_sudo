    "fields": { "map": ["title", "year", "category"], "keyword": "keywords", "detail": ["原因/背景", "影响/做法"], "filter": ["category"] },
    "mapChunkSize": 200,
    "detailChunkSize": 100,
    "blockCount": 1,
    "bucketSize": 2048,
